---
/** The only recurring pull-line treatment (design.md 4): Literata italic lead, 2px ink rule at left. */
import type { Para as ParaT } from "../lib/content";
import Para from "./Para.astro";
interface Props {
  para: ParaT;
  class?: string;
}
const { para, class: cls } = Astro.props;
---
<div class:list={["takeaway col-text", cls]}><Para para={para} class="text-lead italic text-ink measure-lead" /></div>
<style>
  .takeaway {
    border-left: 2px solid currentColor;
    padding-left: 1.25rem;
  }
  @media (width >= 64rem) {
    .takeaway {
      margin-left: calc(-1.25rem - 2px);
    }
  }
</style>
