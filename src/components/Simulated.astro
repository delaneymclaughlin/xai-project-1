---
/**
 * The "Simulated" marker (design.md 8.6) for numbers sourced to S28.
 * No JS: links to #limitations. With JS: opens the shared citation popover
 * with the simulation sentence. Cite adds it automatically; use it directly
 * once per instrument caption.
 */
import { SECTION_IDS } from "../lib/content";
interface Props {
  claims?: number[];
}
const { claims = [] } = Astro.props;
---
<a class="sim-marker" href={`#${SECTION_IDS.limitations}`} data-sim-marker data-claims={claims.length ? claims.join(" ") : undefined}>Simulated</a>
<script>
  import "../scripts/cite.ts";
</script>
