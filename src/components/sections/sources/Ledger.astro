---
/**
 * Claims ledger. design.md 8.7. A real <table>; below 64rem each <tr> becomes a
 * row block (CSS grid) with inline labels from data-label. Without JS every
 * row is visible and the controls are hidden. Script: src/scripts/ledger.ts.
 */
import Chip from "../../ui/Chip.astro";
import {
  ledger,
  claimAnchor,
  sourceAnchor,
  sourceNumber,
  checkStatus,
  factcheckMeta,
  sourceDomain,
  LEDGER_SECTION_LABEL,
} from "../../../lib/content";

const PREVIEW = 12;
const CHECKS = ["Checked against sources", "Wording corrected", "Simulation result"] as const;
const sectionKeys = Object.keys(LEDGER_SECTION_LABEL).filter((k) => ledger.some((r) => r.section === k));

const dateFmt = (iso: string) => {
  const d = new Date(iso + (iso.length === 10 ? "T12:00:00" : ""));
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
};
const checkedOn = dateFmt(factcheckMeta.checked_on);

/** "Site: Hook; Poster: Hook" -> "Hook" (the Site part only). */
const siteWhere = (where: string) => {
  const part = where.split(";").map((p) => p.trim()).find((p) => /^site\s*:/i.test(p));
  return part ? part.replace(/^site\s*:\s*/i, "") : "";
};

const rows = ledger.map((r) => {
  const c = checkStatus(r.id);
  const where = siteWhere(r.where);
  const search = [
    r.id,
    r.text,
    r.sources.join(" "),
    r.sources.map((s) => sourceNumber(s)).join(" "),
    where,
    c.checkLabel,
    c.verdictLabel,
    c.note ?? "",
  ]
    .join(" ")
    .toLowerCase();
  return { r, c, where, search, hasDetails: Boolean(c.note || c.evidenceUrls.length || (c.changed && c.before)) };
});
---
<div class="col-wide ledger" data-ledger data-preview={PREVIEW} data-total={ledger.length}>
  <div class="ledger-controls" data-ledger-controls hidden>
    <div class="ledger-search">
      <label for="ledger-search" class="font-sans text-small font-semibold text-ink">Find a claim</label>
      <input
        id="ledger-search"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="A word, a number or a source"
        aria-controls="ledger-body"
        data-ledger-search
      />
    </div>

    <div class="ledger-filters">
      <div class="ledger-group" role="group" aria-labelledby="ledger-f-section">
        <span id="ledger-f-section" class="ledger-group-label">Section</span>
        <div class="ledger-chips">
          {sectionKeys.map((k) => <Chip data-filter="section" data-value={k} aria-controls="ledger-body">{LEDGER_SECTION_LABEL[k]}</Chip>)}
        </div>
      </div>
      <div class="ledger-group" role="group" aria-labelledby="ledger-f-check">
        <span id="ledger-f-check" class="ledger-group-label">Check</span>
        <div class="ledger-chips">
          {CHECKS.filter((c) => rows.some((x) => x.c.checkLabel === c)).map((c) => <Chip data-filter="check" data-value={c} aria-controls="ledger-body">{c}</Chip>)}
        </div>
      </div>
    </div>

    <div class="ledger-status">
      <p class="font-sans text-small text-ink-2 nums" role="status" aria-live="polite" data-ledger-count>
        Showing {ledger.length} of {ledger.length} claims
      </p>
      <button type="button" class="ledger-link" data-ledger-clear hidden>Clear search and filters</button>
    </div>
  </div>

  <table class="ledger-table">
    <caption class="sr-only">
      Every numbered claim on this page, with its sources, where it appears and its fact-check status. Checked {checkedOn}.
    </caption>
    <thead>
      <tr>
        <th scope="col" class="c-id">Claim</th>
        <th scope="col" class="c-text">Text</th>
        <th scope="col" class="c-src">Sources</th>
        <th scope="col" class="c-where">Appears in</th>
        <th scope="col" class="c-check">Check</th>
      </tr>
    </thead>
    <tbody id="ledger-body" data-ledger-body>
      {rows.map(({ r, c, where, search, hasDetails }) => (
        <tr
          id={claimAnchor(r.id)}
          data-claim={r.id}
          data-section={r.section}
          data-check={c.checkLabel}
          data-search={search}
          data-sim={c.checkLabel === "Simulation result" ? "" : undefined}
        >
          <td class="c-id nums" data-label="Claim">
            <a href={`#${claimAnchor(r.id)}`} class="claim-id" aria-label={`Claim ${r.id}`}>{r.id}</a>
          </td>
          <td class="c-text">
            <p class="claim-text">{r.text}</p>
            {hasDetails && (
              <details class="check-details">
                <summary>Fact-check note</summary>
                <div class="check-body">
                  <p class="check-verdict"><strong>{c.verdictLabel}.</strong> Checked {dateFmt(c.checkedOn)}.</p>
                  {c.note && <p>{c.note}</p>}
                  {c.evidenceUrls.length > 0 && (
                    <>
                      <p class="check-sub">Evidence</p>
                      <ul class="evidence">
                        {c.evidenceUrls.map((u) => (
                          <li><a href={u} target="_blank" rel="noopener" class="break-anywhere">{sourceDomain(u) ? `${sourceDomain(u)}: ` : ""}{u}</a></li>
                        ))}
                      </ul>
                    </>
                  )}
                  {c.changed && c.before && (
                    <details class="check-before">
                      <summary>Show original wording</summary>
                      <p class="check-before-note">Superseded. This is the wording before the fact check, kept for the record.</p>
                      <blockquote>{c.before}</blockquote>
                    </details>
                  )}
                </div>
              </details>
            )}
          </td>
          <td class="c-src" data-label="Sources">
            <ul class="src-list">
              {r.sources.map((s) => (
                <li>
                  <a class="src-link nums" href={`#${sourceAnchor(s)}`} aria-label={`Source ${sourceNumber(s)}`}>{sourceNumber(s)}</a>
                </li>
              ))}
            </ul>
          </td>
          <td class="c-where" data-label="Appears in">{where || "Not shown on the page"}</td>
          <td class="c-check" data-label="Check">
            <span class="check-word" data-kind={c.checkLabel === "Simulation result" ? "sim" : c.checkLabel === "Wording corrected" ? "fix" : "ok"}>
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                {c.checkLabel === "Simulation result" ? (
                  <path d="M7 2 12 7 7 12 2 7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                ) : c.checkLabel === "Wording corrected" ? (
                  <path d="M2.5 11.5 3 9l6.5-6.5 2 2L5 11l-2.5.5ZM8.2 3.8l2 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
                ) : (
                  <path d="M2.5 7.4 5.6 10.5 11.5 3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                )}
              </svg>
              {c.checkLabel}
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="ledger-empty font-sans text-small text-ink-2" data-ledger-empty hidden>
    No claim matches. Try fewer words, or clear the filters.
  </p>

  <div class="ledger-more" data-ledger-more hidden>
    <button type="button" class="ledger-showall" data-ledger-showall aria-controls="ledger-body" aria-expanded="false">
      Show all {ledger.length} claims
    </button>
  </div>
</div>

<style>
  .ledger {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    color: var(--color-ink);
  }

  /* Controls */
  .ledger-controls { display: grid; gap: 1.25rem; margin-bottom: 1.5rem; }
  .ledger-controls[hidden] { display: none; }
  .ledger-search { display: grid; gap: 0.375rem; max-width: 28rem; }
  .ledger-search input {
    min-height: 44px;
    width: 100%;
    padding: 0 0.875rem;
    border: 1px solid var(--color-ink-3);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem;
  }
  .ledger-search input::placeholder { color: var(--color-ink-3); }
  .ledger-filters { display: grid; gap: 0.875rem; }
  .ledger-group { display: grid; gap: 0.375rem; }
  .ledger-group-label { font-weight: 600; color: var(--color-ink-2); }
  .ledger-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ledger-status { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.25rem; }
  .ledger-status p { margin: 0; }
  .ledger-link {
    background: none; border: 0; padding: 0.5rem 0; min-height: 44px;
    font: inherit; color: var(--color-ink); text-decoration: underline; text-underline-offset: 0.18em; cursor: pointer;
  }
  .ledger-link[hidden] { display: none; }

  /* Table: row blocks by default */
  .ledger-table { width: 100%; border-collapse: collapse; display: block; }
  .ledger-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .ledger-table tbody { display: block; border-bottom: 1px solid var(--color-rule); }
  .ledger-table tbody tr {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: "id check" "text text" "src src" "where where";
    gap: 0.25rem 1rem;
    padding: 1rem 0.5rem 1rem 0.5rem;
    margin-inline: -0.5rem;
    border-top: 1px solid var(--color-rule);
    transition: background-color var(--dur-reveal) var(--ease-out);
  }
  .ledger-table tbody tr[hidden] { display: none; }
  .ledger-table td { display: block; min-width: 0; padding: 0; }
  .c-id { grid-area: id; font-weight: 600; }
  .c-check { grid-area: check; justify-self: end; text-align: right; }
  .c-text { grid-area: text; padding-block: 0.25rem; }
  .claim-text { margin: 0; font-size: 1rem; line-height: 1.5; max-width: 66ch; }
  .c-src { grid-area: src; }
  .c-where { grid-area: where; color: var(--color-ink-2); }
  .c-src, .c-where { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.5rem; }
  .c-src[data-label]::before, .c-where[data-label]::before {
    content: attr(data-label);
    color: var(--color-ink-3);
    font-weight: 600;
    margin-right: 0.5rem;
  }
  .c-id[data-label]::before, .c-check[data-label]::before { content: none; }
  .c-check { text-align: right; }

  .claim-id {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; margin: -0.625rem 0 -0.625rem -0.5rem; padding-inline: 0.5rem;
  }
  .src-list { display: flex; flex-wrap: wrap; gap: 0.125rem; list-style: none; margin: 0; padding: 0; }
  .src-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 28px; min-height: 28px; padding-inline: 0.25rem; font-weight: 600;
  }

  .check-word { display: inline-flex; align-items: center; gap: 0.375rem; font-weight: 600; color: var(--color-ink); }
  .check-word svg { flex: none; color: var(--color-ink-2); }
  .check-word[data-kind="sim"] { color: var(--color-ink-2); }

  /* Disclosures */
  .check-details { margin-top: 0.25rem; text-align: left; }
  summary {
    display: inline-flex; align-items: center; min-height: 32px;
    cursor: pointer; color: var(--color-ink-2); text-decoration: underline; text-underline-offset: 0.18em;
  }
  summary:hover { color: var(--color-ink); }
  .check-body {
    margin-top: 0.25rem; padding: 0.75rem 0.875rem; background: var(--color-surface);
    border: 1px solid var(--color-rule); border-radius: var(--radius-panel);
    display: grid; gap: 0.5rem; max-width: 60ch;
  }
  .check-body p { margin: 0; }
  .check-sub { font-weight: 600; color: var(--color-ink-2); }
  .evidence { margin: 0; padding-left: 1rem; display: grid; gap: 0.25rem; }
  .check-before { border-top: 1px solid var(--color-rule); padding-top: 0.25rem; }
  .check-before-note { color: var(--color-ink-2); }
  blockquote { margin: 0.25rem 0 0; padding-left: 0.75rem; border-left: 2px solid var(--color-rule); color: var(--color-ink-2); }

  /* Target highlight */
  .ledger-table tbody tr.is-target { background: var(--color-day-2); box-shadow: inset 3px 0 0 var(--color-ink-3); }

  .ledger-empty { margin: 1rem 0 0; }
  .ledger-empty[hidden], .ledger-more[hidden] { display: none; }
  .ledger-more { margin-top: 1.25rem; }
  .ledger-showall {
    min-height: 44px; padding: 0 1.25rem; border-radius: 9999px;
    border: 1px solid var(--color-ink); background: var(--color-surface); color: var(--color-ink);
    font: inherit; font-weight: 600; cursor: pointer;
  }
  .ledger-showall:hover { background: var(--color-day-2); }

  /* Wide: real table columns */
  @media (width >= 64rem) {
    .ledger-controls { grid-template-columns: minmax(0, 1fr); }
    .ledger-filters { grid-template-columns: auto 1fr; gap: 0.875rem 2.5rem; }
    .ledger-table { display: table; table-layout: fixed; }
    .ledger-table thead { position: static; width: auto; height: auto; overflow: visible; clip-path: none; white-space: normal; }
    .ledger-table tbody { display: table-row-group; border-bottom: 0; }
    .ledger-table thead tr { display: table-row; }
    .ledger-table th {
      text-align: left; padding: 0 1rem 0.625rem 0; font-weight: 600; color: var(--color-ink-2);
      border-bottom: 1px solid var(--color-ink-3);
    }
    .ledger-table tbody tr { display: table-row; margin: 0; padding: 0; }
    .ledger-table tbody tr[hidden] { display: none; }
    .ledger-table td { display: table-cell; padding: 0.875rem 1rem 0.875rem 0; border-top: 1px solid var(--color-rule); vertical-align: top; }
    .ledger-table tbody tr { border-top: 0; }
    .ledger-table tbody tr.is-target td:first-child { box-shadow: inset 3px 0 0 var(--color-ink-3); }
    .ledger-table tbody tr.is-target { box-shadow: none; }
    .ledger-table th.c-id, .ledger-table td.c-id { width: 3.5rem; }
    .ledger-table th.c-src, .ledger-table td.c-src { width: 6.5rem; display: table-cell; }
    .ledger-table th.c-where, .ledger-table td.c-where { width: 8rem; display: table-cell; }
    .ledger-table th.c-check, .ledger-table td.c-check { width: 12rem; text-align: left; }
    .c-src[data-label]::before, .c-where[data-label]::before { content: none; }
    .claim-text { font-size: 0.9375rem; }
    .claim-id { margin: -0.5rem 0 -0.5rem -0.5rem; }
    .check-details { margin-top: 0.125rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger-table tbody tr { transition: none; }
  }
</style>

<script>
  import "../../../scripts/ledger.ts";
</script>
