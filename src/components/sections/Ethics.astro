---
/** Philosophical lens (#act-ethics). design.md 6.5. No script. */
import Section from "../Section.astro";
import LensHeading from "../LensHeading.astro";
import Takeaway from "../Takeaway.astro";
import Para from "../Para.astro";
import { ethics } from "../../lib/content";
---
<Section id={ethics.id}>
  <LensHeading lens={ethics} />
  <Para para={ethics.intro} class="col-text text-lead measure-lead" />
  <div class="col-wide">
    {ethics.pillars.map((p) => (
      <div class="grid grid-cols-1 gap-x-6 gap-y-3 border-t border-rule py-8 first:pt-8 lg:grid-cols-10">
        <div class="lg:col-span-2">
          <h3 class="font-serif text-h3 italic text-ink">{p.name}</h3>
          <p class="mt-2 font-sans text-small text-ink-2">{p.line}</p>
        </div>
        <Para para={p.body} class="text-body measure lg:col-span-6 lg:col-start-3" />
      </div>
    ))}
  </div>
  <Takeaway para={ethics.takeaway} />
</Section>
