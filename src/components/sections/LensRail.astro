---
/**
 * Lens rail (desktop, sticky in the rail column) plus the tablet/mobile top
 * progress line and lens-name bar. design.md 6.3. Script: src/scripts/lens-rail.ts.
 * index.astro renders this as the first child of a `relative` wrapper around
 * the four lens sections, so an absolutely positioned full-height container
 * here can hold a sticky list that spans exactly the lenses.
 */
import { lenses } from "../../lib/content";
const ids = lenses.map((l) => l.id).join(" ");
---
<div class="pointer-events-none absolute inset-0 z-10" data-lens-rail data-ids={ids}>
  <div class="container-page page-grid h-full">
    <div class="col-rail h-full">
      <nav aria-label="Lenses" class="pointer-events-auto sticky top-[33vh] w-fit">
        <ul class="flex flex-col gap-1">
          {lenses.map((l) => (
            <li>
              <a
                href={`#${l.id}`}
                data-lens-link={l.id}
                class="block border-l-2 border-transparent py-1.5 pl-3 font-sans text-small text-ink-3 no-underline transition-colors duration-(--dur-quick) hover:text-ink aria-[current=true]:border-ink aria-[current=true]:font-semibold aria-[current=true]:text-ink"
              >{l.lens}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</div>

<div class="lens-progress lg:hidden" aria-hidden="true"></div>
<div
  class="lens-bar fixed inset-x-0 top-0 z-40 hidden h-10 items-center border-b border-rule bg-day px-4 font-sans text-small text-ink data-[show=true]:flex lg:!hidden"
  data-lens-bar
  aria-hidden="true"
>
  <span class="text-ink-3">Lens</span><span class="mx-2 text-rule">/</span><span class="font-semibold" data-lens-bar-name></span>
</div>

<style>
  .lens-progress {
    display: none;
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 50;
    background: var(--color-rule);
    pointer-events: none;
  }
  @supports (animation-timeline: scroll(root)) {
    .lens-progress {
      display: block;
    }
    .lens-progress::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--color-ink);
      transform-origin: 0 50%;
      transform: scaleX(0);
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
    /* Name in its own rule so the minifier can't fold the timeline into an
       \`animation\` shorthand (Chromium rejects that shorthand). */
    .lens-progress::after { animation-name: lens-progress; }
    @media (width >= 64rem) {
      .lens-progress { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lens-progress { display: none; }
    }
  }
  @keyframes lens-progress {
    to { transform: scaleX(1); }
  }
</style>

<script>
  import "../../scripts/lens-rail.ts";
</script>
