---
/** Limitations (#limitations). design.md 6.10. No script. */
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import Para from "../Para.astro";
import { limitations } from "../../lib/content";
---
<Section id={limitations.id} spacing="block">
  <SectionHeading section={limitations.id} size="h3">{limitations.heading}</SectionHeading>
  <ul class="col-text flex flex-col gap-4 font-serif text-body text-ink-2 list-none p-0">
    {limitations.items.map((item) => (
      <Para
        para={item}
        as="li"
        class="relative pl-6 before:absolute before:left-0 before:top-0 before:text-ink-3 before:content-['–']"
      />
    ))}
  </ul>
</Section>
