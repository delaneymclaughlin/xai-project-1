---
/** Thesis (#thesis, day) plus the table of contents of the four lens questions. design.md 6.4. */
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import Claim from "../Claim.astro";
import Para from "../Para.astro";
import { thesis, lenses, splitSentences } from "../../lib/content";

const [firstPara, ...restParas] = thesis.paragraphs;
const [firstSpan, ...restSpans] = firstPara;
const [display, ...afterDisplay] = splitSentences(firstSpan.t);
// Same sources/claims, text split by sentence only (characters unchanged).
const displayText = { ...firstSpan, t: display };
const remainder = afterDisplay.length ? [{ ...firstSpan, t: afterDisplay.join(" ") }, ...restSpans] : restSpans;
---
<Section id={thesis.id}>
  <SectionHeading section={thesis.id} class="font-sans text-small font-semibold text-ink-3 !text-small">{thesis.heading}</SectionHeading>
  <p class="col-text font-serif text-display font-normal text-ink measure-display"><Claim text={displayText} /></p>
  <div class="col-text flex flex-col gap-6">
    {remainder.length > 0 && <Para para={remainder} class="text-lead text-ink-2 measure-lead" />}
    {restParas.map((p) => <Para para={p} class="text-lead text-ink-2 measure-lead" />)}
  </div>
  <nav class="col-text" aria-label="The four lenses">
    <ul class="flex flex-col divide-y divide-rule border-y border-rule">
      {lenses.map((l) => (
        <li>
          <a
            href={`#${l.id}`}
            class="group flex flex-col gap-1 py-4 text-body text-ink no-underline sm:flex-row sm:items-baseline sm:gap-6"
          >
            <span class="w-20 shrink-0 font-sans text-small font-semibold text-ink-3">{l.lens}</span>
            <span class="font-serif underline decoration-rule decoration-1 underline-offset-4 transition-[text-decoration-color] duration-(--dur-quick) group-hover:decoration-ink group-focus-visible:decoration-ink">{l.question}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Section>
