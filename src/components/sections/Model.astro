---
import SectionHead from "../SectionHead.astro";
import Cite from "../Cite.astro";
import { posts, shapMax, featureLabels, plainLabels, stats, per100, baseline, TOLD, HIDDEN_TOP } from "../../lib/sim";

const fmt = (v: number) => (v >= 0 ? "+" : "−") + Math.abs(v).toFixed(3);
const halfW = (v: number) => `${((Math.abs(v) / shapMax) * 50).toFixed(2)}%`;
type P = (typeof posts)[number];
const base = baseline.toFixed(3);
const meta = (p: P) => `Ranked #${p.rank}. Score ${p.score.toFixed(3)}: the average, ${base}, plus the bars below.`;
const pushes = (p: P) => {
  const up = p.shap.filter((x) => x.v > 0).sort((a, b) => b.v - a.v)[0];
  const down = p.shap.filter((x) => x.v < 0).sort((a, b) => a.v - b.v)[0];
  const f2 = (v: number) => (v >= 0 ? "+" : "−") + Math.abs(v).toFixed(2);
  const parts = [];
  if (up) parts.push(`Biggest push up: ${plainLabels[up.f]} (${f2(up.v)}).`);
  if (down) parts.push(`Biggest push down: ${plainLabels[down.f]} (${f2(down.v)}).`);
  return parts.join(" ");
};
const top = posts.find((p) => p.rank === 1)!;
const topEi = top.shap.find((x) => x.f === HIDDEN_TOP)!;
const labData = JSON.stringify({
  max: shapMax,
  told: TOLD,
  hidden: HIDDEN_TOP,
  labels: featureLabels,
  posts: posts.map((p) => ({ id: p.id, title: p.title, meta: meta(p), sum: pushes(p), shap: p.shap })),
});
const scoreMax = Math.max(...posts.map((p) => p.score));

const grids = [
  { n: per100(stats.shareAll), exact: `${stats.shareAll}%`, label: "Every 100 posts", sub: "of all simulated posts" },
  { n: per100(stats.shareTop), exact: `${stats.shareTop}%`, label: "Every 100 top-ranked", sub: "of the top 10% of rankings", hot: true },
  { n: per100(stats.shareTopNoIntensity), exact: `${stats.shareTopNoIntensity}%`, label: "Top-ranked, no emotional intensity", sub: "of the top 10%, ranker retrained without it" },
];

const methods = [
  {
    name: "SHAP",
    does: "Splits a post’s score into each signal’s share. The shares add up exactly to the score.",
    found: "Emotional intensity was the biggest share, nearly tied with her past engagement with the topic.",
    s: ["S69", "S28"],
  },
  {
    name: "LIME",
    does: "Builds a simpler stand-in model around one post and reads its reasons. Quicker, but approximate.",
    found: `Named past engagement as the main reason in ${stats.limeRuns} of ${stats.limeReruns} reruns, but the stand-in reproduced only about ${stats.limeFit}% of the ranker’s behavior around that post.`,
    s: ["S70", "S28"],
  },
  {
    name: "Counterfactual",
    does: "Asks what would have to change to knock the post out of her top three.",
    found: `No change to the teen’s own history did: with no past engagement at all, the post still ranked #${stats.cfRankNoHistory}. Only lowering its emotional intensity from ${stats.cfIntensityFrom} to ${stats.cfIntensityTo} did.`,
    s: ["S21", "S28"],
  },
];

const tests = [
  { name: "Fidelity", q: "Does the explanation match what the model does?", verdict: "Pass / Partial", tone: "mixed",
    a: `SHAP’s shares add up exactly to the score (pass). LIME’s stand-in reproduced about ${stats.limeFit}% (partial).` },
  { name: "Faithfulness", q: "Do the signals it names really drive the score?", verdict: "Pass", tone: "pass",
    a: `Taking away the two signals SHAP ranked highest lowered the score about ${Math.round(Number(stats.faithTop) / Number(stats.faithRandom))} times as much as taking away two at random (${stats.faithTop} vs. an average of ${stats.faithRandom}).` },
  { name: "Stability", q: "Same answer if you ask again?", verdict: "Pass", tone: "pass",
    a: `LIME gave the same top reason in ${stats.limeRuns} of ${stats.limeReruns} reruns; SHAP’s top three held when the post was nudged.` },
  { name: "Completeness", q: "Does it cover the main reasons?", verdict: "Fail", tone: "fail",
    a: `SHAP’s top three reasons explain ${stats.top3Pct}% of the score; the one reason a platform would show explains only ${stats.toldPct}%.` },
  { name: "Human usefulness", q: "Could the teen actually use it?", verdict: "Fail", tone: "fail",
    a: "Not tested with users. Judged against its audience, a SHAP number is not something a 14-year-old can act on." },
];
---
<section class="section-y model" id="model" aria-labelledby="model-h">
  <div class="wrap">
    <div class="head-row">
      <SectionHead id="model-h" lens={{ n: 3, name: "Technical" }}>Inside a simulated feed</SectionHead>
      <p class="lede measure head-aside">A ranker, a model that predicts what someone will engage with, learned from {stats.impressions} simulated post views. Then it ordered the feed of a simulated {stats.age}-year-old.<Cite ids={["S28"]} /></p>
    </div>

    <figure class="proxy">
      <figcaption class="proxy-text">
        <p class="proxy-lead">Distress-related posts (on sad, hopeless topics, like the sad-edit video and late-night venting post below) were about <strong>{grids[0].n} in every 100</strong> simulated posts. Among the posts the ranker scored highest, they were <strong class="hot">{grids[1].n} in every 100</strong>.<Cite ids={["S28"]} /></p>
        <p>Even with the “emotional intensity” signal removed, {grids[2].n} in every 100 top-ranked posts still were.<Cite ids={["S28"]} /></p>
        <p>Nobody told the ranker which posts were distress-related. It learned that they keep people engaged.<Cite ids={["S28"]} /></p>
      </figcaption>
      <ul class="grids">
        {grids.map((g) => (
          <li class:list={["grid", { hot: g.hot }]}>
            <p class="g-label">{g.label}</p>
            <p class="g-n"><span class="num">{g.n}</span> in 100</p>
            <span class="g-cells" role="img" aria-label={`${g.n} of 100 squares filled`}>
              {Array.from({ length: 100 }, (_, i) => <span class:list={["c", { on: i < g.n }]}></span>)}
            </span>
            <p class="g-exact">Exactly {g.exact} {g.sub}</p>
          </li>
        ))}
      </ul>
    </figure>
  </div>

  <feed-lab class="lab on-navy" data-lab={labData}>
    <div class="wrap lab-grid">
      <div class="lab-feed">
        <div class="lab-top">
          <h3 class="lab-h">A simulated 14-year-old’s feed</h3>
          <button type="button" class="switch" role="switch" aria-checked="false" data-switch>
            <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
            <span>What if the ranker ignored emotional intensity?</span>
          </button>
        </div>
        <p class="lab-help small">Click a post to see why it ranks where it does. Emotional intensity is how emotionally charged a post is; the switch shows the feed from a ranker retrained without that signal.<Cite ids={["S28"]} /></p>
        <ol class="feed" aria-label="Simulated feed, ranked">
          {posts.map((p) => (
            <li data-post={p.id} data-rank={p.rank} data-cf-rank={p.cfRank}>
              <button type="button" class="post" aria-pressed={p.rank === 1 ? "true" : "false"} aria-controls="shap-panel" data-target={p.id}>
                <span class="post-rank num" data-rank-label>{p.rank}</span>
                <span class="post-body">
                  <span class="post-title">{p.title}</span>
                  {p.distress && <span class="post-tag">Distress-related</span>}
                </span>
                <span class="post-score">
                  <span class="post-score-track" aria-hidden="true"><span style={`width:${((p.score / scoreMax) * 100).toFixed(1)}%`}></span></span>
                  <span class="post-score-v"><span class="sr-only">Score </span>{p.score.toFixed(2)}</span>
                </span>
                <span class="post-move" data-move aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ol>
        <p class="lab-sim small">Simulated feed, user and model. No real platform data.</p>
      </div>

      <div class="lab-panel" id="shap-panel" aria-live="polite">
        <p class="cf-note" data-cf-note hidden>
          The same two distress-related posts stay on top. Other signals, how much of a post people watch and how often they comment, carry the same information.<Cite ids={["S28"]} /> <span class="cf-sub">The bars below are still the original ranker’s.</span>
        </p>
        <div class="shap swap" data-shap>
          <h4 class="shap-h" data-shap-title>{top.title}</h4>
          <p class="shap-sum" data-shap-sum>{pushes(top)}</p>
          <p class="shap-meta small" data-shap-meta>{meta(top)}</p>
          <ul class="shap-bars" data-shap-bars aria-label="Signals that moved this post's score">
            {top.shap.map((x) => (
              <li class:list={["sb", { neg: x.v < 0, told: x.f === TOLD, hidden: x.f === HIDDEN_TOP }]}>
                <span class="sb-l">{featureLabels[x.f]}</span>
                <span class="sb-track" aria-hidden="true"><span class="sb-fill" style={`width:${halfW(x.v)}`}></span></span>
                <span class="sb-v">{fmt(x.v)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="howto small">
          <p><strong>How to read this.</strong> The score is how strongly the ranker predicts this teen will engage with the post; higher scores are shown first. Every post starts from the average score, {base}. Each bar is how much one signal pushed this post up (right, +) or down (left, −): on the top post, {fmt(topEi.v)} means its emotional intensity alone raised its score by {topEi.v.toFixed(3)}.</p>
        </div>
        <ul class="shap-key small" aria-label="Key">
          <li><span class="k k-hidden"></span>Emotional intensity of the post</li>
          <li><span class="k k-told"></span>User’s past engagement with this topic</li>
          <li><span class="k k-other"></span>Other signals</li>
        </ul>
        <p class="shap-how small">Technical term: these bars are SHAP values.<Cite ids={["S69", "S28"]} /></p>
        <button type="button" class="back-to-feed small" data-back>&uarr; Back to the feed</button>
      </div>
    </div>
  </feed-lab>

  <div class="wrap">
    <div class="methods-block">
      <h3 class="h-item">Three ways to explain a ranking</h3>
      <ul class="methods">
        {methods.map((m) => (
          <li class="method">
            <p class="m-name">{m.name}</p>
            <p class="m-does">{m.does}</p>
            <p class="m-found"><span class="m-k">Here:</span> {m.found}<Cite ids={m.s} /></p>
          </li>
        ))}
      </ul>
    </div>
    <div class="after">
      <h3 class="h-item">Five tests of those explanations<Cite ids={["S20", "S28"]} /></h3>
      <ul class="tests">
        {tests.map((t) => (
          <li class:list={["test", t.tone]}>
            <span class="test-name">{t.name}</span>
            <span class="test-q">{t.q}</span>
            <span class="test-v">{t.verdict}</span>
            <span class="test-a">{t.a}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .head-row { display: grid; gap: 1.25rem; }
  @media (width >= 64rem) {
    .head-row { grid-template-columns: 7fr 5fr; gap: 4rem; align-items: end; }
  }
  .head-aside { color: var(--color-ink-2); }

  /* Proxy stat: three 10x10 grids */
  .proxy { margin-top: 3rem; display: grid; gap: 2.25rem; align-items: start; }
  @media (width >= 64rem) { .proxy { grid-template-columns: 5fr 7fr; gap: 4rem; } }
  .proxy-text { display: grid; gap: 0.9rem; font-size: 1rem; line-height: 1.6; max-width: 50ch; }
  .proxy-lead { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem); line-height: 1.55; }
  .proxy-lead strong { font-weight: 700; }
  .proxy-lead strong.hot { color: var(--color-orange-ink); }
  .grids { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (width >= 40rem) { .grids { gap: 2rem; } }
  .grid { display: grid; grid-row: span 4; grid-template-rows: subgrid; gap: 0.5rem; }
  .g-label { font-size: 0.875rem; line-height: 1.3; font-weight: 700; align-self: end; }
  .g-n { font-size: 0.9375rem; }
  .g-n .num { font-size: clamp(2.5rem, 1.6rem + 3vw, 4.25rem); margin-right: 0.15rem; }
  .grid.hot .g-n .num { color: var(--color-orange); }
  .g-cells { display: grid; grid-template-columns: repeat(10, 1fr); gap: 2px; }
  .g-cells .c { aspect-ratio: 1; background: var(--color-track); }
  .g-cells .c.on { background: var(--color-navy); }
  .grid.hot .g-cells .c.on { background: var(--color-orange); }
  .g-exact { font-size: 0.75rem; line-height: 1.35; color: var(--color-ink-2); }
  @media (width < 30rem) { .g-label { font-size: 0.75rem; } }

  /* The lab */
  .lab { display: block; margin-top: 3.5rem; background: var(--color-navy); color: var(--color-paper); padding-block: 2.5rem; }
  @media (width >= 64rem) { .lab { padding-block: 3.5rem; } }
  .lab-grid { display: grid; gap: 2.5rem; }
  @media (width >= 64rem) { .lab-grid { grid-template-columns: 6fr 6fr; gap: 3.5rem; } }
  .lab-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; margin-bottom: 1rem; }
  .lab-h { font-family: var(--font-display); text-transform: uppercase; font-weight: 400; font-size: 1.375rem; letter-spacing: 0.02em; }
  .lab-sim { margin-top: 0.9rem; color: var(--color-mist); font-style: italic; }
  .lab-help { margin: -0.25rem 0 1rem; color: var(--color-mist); max-width: 60ch; }
  .cf-sub { display: block; margin-top: 0.4rem; font-size: 0.8125rem; color: var(--color-mist); }
  .shap-sum { margin-top: 0.75rem; font-size: 1.0625rem; line-height: 1.5; }
  .howto { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-navy-3); color: var(--color-mist); line-height: 1.55; }
  .howto strong { color: var(--color-paper); }

  .switch {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font: inherit; font-size: 0.9375rem; color: var(--color-paper);
    background: none; border: 0; padding: 0.3rem 0; cursor: pointer; text-align: left;
  }
  .switch-track { width: 2.6rem; height: 1.4rem; border: 2px solid var(--color-mist); position: relative; flex: none; transition: background-color .2s, border-color .2s; }
  .switch-knob { position: absolute; top: 2px; left: 2px; width: 0.9rem; height: 0.9rem; background: var(--color-mist); transition: transform .2s; }
  .switch[aria-checked="true"] .switch-track { background: var(--color-orange); border-color: var(--color-orange); }
  .switch[aria-checked="true"] .switch-knob { transform: translateX(1.2rem); background: var(--color-paper); }

  .feed { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .post {
    width: 100%;
    display: grid;
    grid-template-columns: 2.25rem 1fr 6.5rem 1.75rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    font: inherit;
    text-align: left;
    color: var(--color-navy);
    background: var(--color-paper);
    border: 0;
    border-left: 6px solid transparent;
    cursor: pointer;
  }
  .post:hover { background: #fff; }
  .post[aria-pressed="true"] { border-left-color: var(--color-orange); box-shadow: inset 0 0 0 2px var(--color-orange); }
  .post-rank { font-size: 1.75rem; text-align: center; }
  .post-body { display: grid; gap: 0.15rem; min-width: 0; }
  .post-title { font-size: 0.9375rem; line-height: 1.35; }
  .post-tag { font-size: 0.75rem; font-style: italic; color: var(--color-orange-ink); display: inline-flex; align-items: center; gap: 0.35rem; }
  .post-tag::before { content: ""; width: 0.55rem; height: 0.55rem; background: var(--color-orange); }
  .post-score { display: grid; gap: 0.2rem; justify-items: end; transition: opacity .3s; }
  .post-score-track { width: 100%; height: 0.4rem; background: var(--color-track); display: block; }
  .post-score-track span { display: block; height: 100%; background: var(--color-navy); }
  .post-score-v { font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
  .post-move { font-size: 0.75rem; text-align: center; color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  :global(feed-lab[data-cf]) .post-score { opacity: 0.25; }
  @media (width < 30rem) {
    .post { grid-template-columns: 1.75rem 1fr 3.25rem 1.4rem; gap: 0.5rem; padding-inline: 0.5rem; }
    .post-score-track { display: none; }
  }

  .lab-panel { background: var(--color-navy-2); padding: 1.5rem; align-self: start; scroll-margin-top: 4.5rem; }
  @media (width >= 64rem) { .lab-panel { padding: 2rem; position: sticky; top: 5rem; } }
  .feed :global(li) { scroll-margin-top: 5rem; scroll-margin-bottom: 1.5rem; }
  .back-to-feed { margin-top: 1.25rem; width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--color-mist); background: transparent; color: var(--color-paper); font: inherit; cursor: pointer; }
  .back-to-feed:hover { background: var(--color-navy-3); }
  @media (width >= 64rem) { .back-to-feed { display: none; } }
  .cf-note { margin-bottom: 1.25rem; padding: 0.8rem 1rem; border-left: 4px solid var(--color-orange-lit); background: var(--color-navy); font-size: 0.9375rem; line-height: 1.55; }
  .shap-h { font-family: var(--font-display); text-transform: uppercase; font-weight: 400; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); line-height: 1; letter-spacing: 0.01em; }
  .shap-meta { margin-top: 0.5rem; color: var(--color-mist); }
  .shap-bars { list-style: none; padding: 0; margin-top: 1.25rem; display: grid; gap: 0.55rem; }
  .lab-panel :global(.sb) { display: grid; grid-template-columns: minmax(0, 12.5rem) 1fr 3.75rem; gap: 0.75rem; align-items: center; }
  .lab-panel :global(.sb-l) { font-size: 0.875rem; line-height: 1.3; color: var(--color-mist); }
  .lab-panel :global(.sb-v) { font-size: 0.8125rem; text-align: right; font-variant-numeric: tabular-nums; }
  .lab-panel :global(.sb-track) { position: relative; height: 1.25rem; display: block; }
  .lab-panel :global(.sb-track::before) { content: ""; position: absolute; left: 50%; top: -0.2rem; bottom: -0.2rem; width: 1px; background: var(--color-mist); }
  .lab-panel :global(.sb-fill) { position: absolute; left: 50%; top: 0; bottom: 0; background: #8e95b8; }
  .lab-panel :global(.sb.neg .sb-fill) { left: auto; right: 50%; }
  .lab-panel :global(.sb.told .sb-fill) { background: var(--color-paper); }
  .lab-panel :global(.sb.told .sb-l) { color: var(--color-paper); }
  .lab-panel :global(.sb.hidden .sb-fill) { background: var(--color-orange-lit); }
  .lab-panel :global(.sb.hidden .sb-l) { color: var(--color-paper); }
  @media (prefers-reduced-motion: no-preference) {
    .lab-panel :global(.shap.swap .sb-fill) { animation: sbgrow 0.5s cubic-bezier(.2,.7,.2,1) both; }
    .lab-panel :global(.sb:not(.neg) .sb-fill) { transform-origin: left; }
    .lab-panel :global(.sb.neg .sb-fill) { transform-origin: right; }
    @keyframes sbgrow { from { transform: scaleX(0); } }
  }
  :global(feed-lab[data-cf]) .shap { opacity: 0.55; }
  @media (width < 30rem) {
    .lab-panel :global(.sb) { grid-template-columns: 1fr 3.5rem; }
    .lab-panel :global(.sb-l) { grid-column: 1 / -1; }
  }
  .shap-key { list-style: none; padding: 0; margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; color: var(--color-mist); }
  .shap-key li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .shap-how { margin-top: 0.6rem; color: var(--color-mist); }
  .k { display: inline-block; width: 0.8rem; height: 0.8rem; flex: none; }
  .k-hidden { background: var(--color-orange-lit); }
  .k-told { background: var(--color-paper); }
  .k-other { background: #8e95b8; }

  /* After the lab */
  .methods-block { margin-top: 3.5rem; }
  .methods { list-style: none; padding: 0; margin-top: 1.25rem; display: grid; gap: 1.5rem; }
  @media (width >= 56rem) { .methods { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .method { border-top: 6px solid var(--color-navy); padding-top: 0.9rem; display: grid; gap: 0.5rem; align-content: start; }
  .m-name { font-family: var(--font-display); text-transform: uppercase; font-size: 1.5rem; line-height: 1; letter-spacing: 0.02em; }
  .m-does { font-size: 1rem; line-height: 1.55; }
  .m-found { font-size: 0.9375rem; line-height: 1.55; color: var(--color-ink-2); }
  .m-k { font-weight: 700; color: var(--color-navy); }

  .after { margin-top: 3rem; }
  .tests { list-style: none; padding: 0; margin-top: 1.25rem; display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
  @media (width >= 40rem) { .tests { grid-template-columns: repeat(2, 1fr); } }
  @media (width >= 56rem) { .tests { grid-template-columns: repeat(3, 1fr); } }
  @media (width >= 72rem) { .tests { grid-template-columns: repeat(5, 1fr); } }
  .test { display: grid; grid-template-rows: auto auto auto 1fr; gap: 0.4rem; align-content: start; padding: 0.9rem 1rem 1rem; background: var(--color-paper); border-top: 6px solid var(--color-navy); }
  .test.fail { border-top-color: var(--color-orange); }
  .test.mixed { border-image: linear-gradient(to right, var(--color-navy) 50%, var(--color-orange) 50%) 1; border-top-width: 6px; border-top-style: solid; }
  .test-name { font-size: 0.8125rem; color: var(--color-ink-2); }
  .test-q { font-size: 1rem; line-height: 1.35; font-weight: 700; }
  @media (width >= 72rem) { .test-q { min-height: 4.05em; } }
  .test-v { font-family: var(--font-display); text-transform: uppercase; font-size: 1.5rem; line-height: 1; margin-top: 0.2rem; }
  .test.fail .test-v { color: var(--color-orange-ink); }
  .test-a { font-size: 0.875rem; line-height: 1.45; }
</style>

<script>
  class FeedLab extends HTMLElement {
    connectedCallback() {
      const list = this.querySelector<HTMLOListElement>(".feed")!;
      const items = [...list.children] as HTMLLIElement[];
      const sw = this.querySelector<HTMLButtonElement>("[data-switch]")!;
      const note = this.querySelector<HTMLElement>("[data-cf-note]")!;
      type Row = { f: string; v: number };
      const data = JSON.parse(this.dataset.lab!) as {
        max: number; told: string; hidden: string; labels: Record<string, string>;
        posts: { id: string; title: string; meta: string; sum: string; shap: Row[] }[];
      };
      const panel = this.querySelector<HTMLElement>("[data-shap]")!;
      const title = this.querySelector<HTMLElement>("[data-shap-title]")!;
      const meta = this.querySelector<HTMLElement>("[data-shap-meta]")!;
      const sum = this.querySelector<HTMLElement>("[data-shap-sum]")!;
      const barsEl = this.querySelector<HTMLUListElement>("[data-shap-bars]")!;
      const fmt = (v: number) => (v >= 0 ? "+" : "\u2212") + Math.abs(v).toFixed(3);
      const buttons = [...this.querySelectorAll<HTMLButtonElement>("button[data-target]")];
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");

      const select = (id: string) => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.target === id)));
        const p = data.posts.find((x) => x.id === id)!;
        title.textContent = p.title;
        meta.textContent = p.meta;
        sum.textContent = p.sum;
        barsEl.replaceChildren(
          ...p.shap.map((x) => {
            const li = document.createElement("li");
            li.className = "sb";
            if (x.v < 0) li.classList.add("neg");
            if (x.f === data.told) li.classList.add("told");
            if (x.f === data.hidden) li.classList.add("hidden");
            const l = document.createElement("span");
            l.className = "sb-l";
            l.textContent = data.labels[x.f];
            const track = document.createElement("span");
            track.className = "sb-track";
            track.setAttribute("aria-hidden", "true");
            const fill = document.createElement("span");
            fill.className = "sb-fill";
            fill.style.width = `${((Math.abs(x.v) / data.max) * 50).toFixed(2)}%`;
            track.append(fill);
            const v = document.createElement("span");
            v.className = "sb-v";
            v.textContent = fmt(x.v);
            li.append(l, track, v);
            return li;
          }),
        );
        panel.classList.remove("swap");
        void panel.offsetWidth;
        panel.classList.add("swap");
      };
      // Below 64rem the panel stacks under the feed, so bring it into view after a pick.
      const stacked = matchMedia("(width < 64rem)");
      const behavior = (): ScrollBehavior => (reduce.matches ? "auto" : "smooth");
      const shapPanel = this.querySelector<HTMLElement>("#shap-panel")!;
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          select(b.dataset.target!);
          if (stacked.matches) shapPanel.scrollIntoView({ behavior: behavior(), block: "start" });
        }),
      );
      this.querySelector<HTMLButtonElement>("[data-back]")!.addEventListener("click", () => {
        const current = buttons.find((b) => b.getAttribute("aria-pressed") === "true") ?? buttons[0];
        current.closest("li")!.scrollIntoView({ behavior: behavior(), block: "nearest" });
        current.focus({ preventScroll: true });
      });

      const rerank = (cf: boolean) => {
        const first = new Map(items.map((el) => [el, el.getBoundingClientRect().top]));
        const key = cf ? "cfRank" : "rank";
        const sorted = [...items].sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]));
        sorted.forEach((el) => {
          list.append(el);
          const r = Number(el.dataset[key]);
          el.querySelector("[data-rank-label]")!.textContent = String(r);
          const move = el.querySelector<HTMLElement>("[data-move]")!;
          const d = Number(el.dataset.rank) - Number(el.dataset.cfRank);
          move.textContent = cf && d !== 0 ? (d > 0 ? `▲${d}` : `▼${-d}`) : cf ? "=" : "";
        });
        if (!reduce.matches) {
          for (const el of sorted) {
            const dy = first.get(el)! - el.getBoundingClientRect().top;
            if (dy) el.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 600, easing: "cubic-bezier(.2,.7,.2,1)" });
          }
        }
        sw.setAttribute("aria-checked", String(cf));
        note.hidden = !cf;
        this.toggleAttribute("data-cf", cf);
      };
      sw.addEventListener("click", () => rerank(sw.getAttribute("aria-checked") !== "true"));
    }
  }
  customElements.define("feed-lab", FeedLab);
</script>
