---
/**
 * h2 for a section, wired to Section's aria-labelledby.
 * For the four lenses use LensHeading instead.
 */
import { headingId } from "../lib/content";
interface Props {
  section: string;
  size?: "h2" | "h3";
  class?: string;
}
const { section, size = "h2", class: cls } = Astro.props;
---
<h2 id={headingId(section)} class:list={["col-text font-serif", size === "h2" ? "text-h2" : "text-h3 font-medium", cls]}><slot /></h2>
