---
/**
 * Section shell: anchor, aria-labelledby, ground (night/day), color-scheme,
 * vertical rhythm and the shared 12-col grid (design.md 5).
 * Children place themselves with col-text / col-wide / col-margin / col-rail.
 * The h2 inside must use id={headingId(id)} (or render <SectionHeading />).
 */
import { headingId } from "../lib/content";
interface Props {
  id: string;
  ground?: "night" | "day";
  /** Vertical padding. "section" = --spacing-section top and bottom. */
  spacing?: "section" | "block" | "none";
  /** false: no container/grid wrapper (full-bleed content). */
  grid?: boolean;
  labelledby?: string;
  class?: string;
  innerClass?: string;
}
const { id, ground = "day", spacing = "section", grid = true, labelledby = headingId(id), class: cls, innerClass } = Astro.props;
---
<section
  id={id}
  aria-labelledby={labelledby}
  data-ground={ground}
  class:list={[
    "relative",
    ground === "night" ? "bg-night text-moon [color-scheme:dark]" : "bg-day text-ink [color-scheme:light]",
    spacing === "section" && "py-section",
    spacing === "block" && "py-block",
    cls,
  ]}
>
  {grid ? <div class:list={["container-page page-grid gap-y-block", innerClass]}><slot /></div> : <slot />}
</section>
