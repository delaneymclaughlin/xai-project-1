---
/**
 * One verified span of copy plus its citation markers. Renders `t` verbatim.
 * Adds data-claim-id (space-separated ledger ids) for the ledger to link back.
 */
import type { Text } from "../lib/content";
import Cite from "./Cite.astro";
interface Props {
  text: Text;
  simMarker?: boolean;
  class?: string;
}
const { text, simMarker = true, class: cls } = Astro.props;
// Keep the last word glued to its citation markers so a marker never wraps
// onto a line of its own. The text itself is rendered unchanged.
const hasCite = text.s.length > 0;
const m = hasCite ? text.t.match(/^([\s\S]*\s)?(\S+)$/) : null;
const head = m ? (m[1] ?? "") : text.t;
const tail = m ? m[2] : "";
---
{m ? (
  <span class={cls} data-claim-id={text.claims.length ? text.claims.join(" ") : undefined}>{head}<span class="whitespace-nowrap">{tail}<Cite s={text.s} claims={text.claims} simMarker={simMarker} /></span></span>
) : (
  <><span class={cls} data-claim-id={text.claims.length ? text.claims.join(" ") : undefined}>{text.t}</span><Cite s={text.s} claims={text.claims} simMarker={simMarker} /></>
)}
