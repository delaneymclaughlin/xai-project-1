{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xai-feed-brief",
  "compatibility_date": "2026-10-18",
  // Assets-only Worker: no "main". Cloudflare serves the static build.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
